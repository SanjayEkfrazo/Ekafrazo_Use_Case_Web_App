# Frontend runtime configuration
# Use your deployed backend API URL in production.
# Option A (recommended): set origin + path, easy to switch only the domain.
VITE_API_ORIGIN=https://api.EkfrazoDataAndAIUseCases.com
VITE_API_PATH=/api

